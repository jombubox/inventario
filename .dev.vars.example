# Makes OpenNext load the development-mode Next.js env files during preview.
NEXTJS_ENV=development

# Server-only values for local Wrangler preview. Never commit .dev.vars.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
