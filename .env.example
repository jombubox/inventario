# Neon PostgreSQL pooled connection string.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=
APP_ENV=development
ENABLE_IMPORTS=true

# Single administrator. Server-only; never use NEXT_PUBLIC_*.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Cloudflare R2. Credentials remain server-only.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
