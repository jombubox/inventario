{
  "name": "jombubox",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/features/admin/server/admin-services.integration.test.ts src/features/catalog/data/public-catalog-queries.integration.test.ts",
    "test:e2e:seed": "tsx src/scripts/seed-catalog-e2e.ts",
    "test:e2e": "pnpm test:e2e:seed && playwright test",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "qa:setup": "node --conditions=react-server --import tsx src/scripts/qa-data.ts setup",
    "qa:cleanup": "node --conditions=react-server --import tsx src/scripts/qa-data.ts cleanup",
    "production:bootstrap": "node --conditions=react-server --import tsx src/scripts/production-bootstrap.ts bootstrap",
    "production:verify": "node --conditions=react-server --import tsx src/scripts/production-bootstrap.ts verify",
    "production:remove-samples": "node --conditions=react-server --import tsx src/scripts/production-bootstrap.ts remove-samples",
    "db:studio": "drizzle-kit studio",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "packageManager": "pnpm@10.15.0"
}
