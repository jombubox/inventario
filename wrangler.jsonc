{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jumbobox",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "jumbobox-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "ENABLE_IMPORTS": "false"
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "NEXT_PUBLIC_SITE_URL",
          "ADMIN_EMAIL",
          "ADMIN_PASSWORD",
          "AUTH_SECRET",
          "CLOUDFLARE_ACCOUNT_ID",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "R2_BUCKET_NAME",
          "R2_PUBLIC_URL"
        ]
      }
    }
  }
}
