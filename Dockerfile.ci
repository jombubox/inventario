FROM node:22-bookworm-slim AS verify

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV APP_ENV=preview
ENV ENABLE_IMPORTS=true

ENV BUILD_DATABASE=postgresql://build:build@127.0.0.1:5432/jumbobox_build
ENV BUILD_SESSION_VALUE=container-build-only-value-at-least-32-characters
ENV BUILD_ORIGIN=http://127.0.0.1:3000

RUN DATABASE_URL=$BUILD_DATABASE \
    BETTER_AUTH_SECRET=$BUILD_SESSION_VALUE \
    BETTER_AUTH_URL=$BUILD_ORIGIN \
    NEXT_PUBLIC_SITE_URL=$BUILD_ORIGIN \
    pnpm cf:build
